# GraphQA Environment Configuration
# Copy this file to .env and fill in your values

# Ollama Configuration (Optional - defaults to localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: Arize Phoenix Observability (for monitoring and debugging)
# No authentication needed - just start the server: python -m phoenix.server.main serve
# PHOENIX_ENDPOINT=http://localhost:6006

# Optional: Custom data paths
# GRAPHQA_DATA_DIR=./data
# GRAPHQA_CACHE_DIR=./cache

# Optional: Performance settings
# GRAPHQA_MAX_GRAPH_SIZE=100000
# GRAPHQA_MAX_MEMORY_MB=2048

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# GRAPHQA_LOG_LEVEL=INFO 